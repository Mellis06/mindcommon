# Copy to .env for local development. Never commit a real .env file.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/mindcommon
# Generate a random secret of at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1h
# Exact browser origin used to serve the frontend.
CORS_ORIGINS=http://localhost:5500
# Browser session cookie. For genuinely cross-site hosting, use COOKIE_SAME_SITE=none and COOKIE_SECURE=true.
COOKIE_SAME_SITE=strict
COOKIE_SECURE=false
# Optional cookie domain, e.g. .example.org. Leave blank for host-only cookie.
COOKIE_DOMAIN=
# Set to 1 only when the API is actually behind exactly one trusted reverse proxy.
TRUST_PROXY=0
