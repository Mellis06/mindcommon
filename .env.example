# Copy to .env for local development. Never commit a real .env file.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/mindcommon
# Generate a random secret of at least 32 characters for local development.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1h
# Comma-separated browser origins. Empty means cross-origin browser requests are disabled.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Set to 1 only when the API is actually behind exactly one trusted reverse proxy.
TRUST_PROXY=0
